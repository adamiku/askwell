# Supabase (dev project for local and preview; prod project for production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Acts as service_role and skips RLS.
SUPABASE_SECRET_KEY=

# Clerk auth and billing
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server only
CLERK_SECRET_KEY=
# Server only. Verifies the Clerk webhook signature.
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI. Server only.
OPENAI_API_KEY=

# Arcjet rate limiting and prompt injection checks. Server only.
ARCJET_KEY=

# PostHog analytics (public project key and host)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Public URL of this app
NEXT_PUBLIC_APP_URL=

# Public key of the project that powers the landing page widget. Server only, read at request time.
LANDING_WIDGET_KEY=

# Lets agents reach protected Vercel previews. The app never reads it.
VERCEL_AUTOMATION_BYPASS_SECRET=
